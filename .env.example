# Puerto del servicio Node
PORT=3000

# Token permanente generado para el usuario del sistema de Meta.
# El usuario del sistema debe tener asignadas la aplicacion y la WABA productiva.
WHATSAPP_ACCESS_TOKEN=

# Identificador interno del numero productivo de WhatsApp.
# NO es el numero visible (+57...), NO es el WABA ID y NO es el access token.
WHATSAPP_PHONE_NUMBER_ID=

# Plantilla de autenticacion aprobada
WHATSAPP_TEMPLATE_NAME=verificacion
WHATSAPP_TEMPLATE_LANGUAGE=es_CO

# Version de Graph API usada por el servicio
META_GRAPH_API_VERSION=v25.0

# Opcional: tiempo maximo de espera por cada solicitud a Meta
META_REQUEST_TIMEOUT_MS=15000

# OPCIONAL / SOLO DIAGNOSTICO
# El endpoint POST /api/probarEnvioOtp requiere esta clave en X-OTP-Test-Key.
# Generar con: openssl rand -hex 32
OTP_TEST_API_KEY=

# true = solo permite 127.0.0.1 / ::1 (recomendado)
OTP_TEST_LOCAL_ONLY=true
